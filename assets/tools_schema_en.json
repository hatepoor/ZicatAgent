[
  {
    "type": "function",
    "function": {
      "name": "code_run",
      "description": "Execute code (python/powershell/bash). Complex tasks prefer python file mode; powershell/bash for one-liner system ops. timeout<=600s. Output is truncated.",
      "parameters": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "description": "code or script content"
          },
          "type": {
            "type": "string",
            "enum": [
              "python",
              "powershell"
            ],
            "description": "python|powershell|bash",
            "default": "python"
          },
          "timeout": {
            "type": "integer",
            "description": "seconds (<=600)",
            "default": 60
          },
          "cwd": {
            "type": "string",
            "description": "working dir for the run"
          },
          "inline_eval": {
            "type": "boolean",
            "description": "eval python inline (dangerous)"
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "file_read",
      "description": "Read a text file. Returns lines with optional start/count; keyword highlight supported.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "file path (relative to cwd)"
          },
          "start": {
            "type": "integer",
            "description": "start line"
          },
          "count": {
            "type": "integer",
            "description": "max lines",
            "default": 200
          },
          "show_linenos": {
            "type": "boolean",
            "description": "show line numbers",
            "default": true
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "file_patch",
      "description": "Patch a file by exact old_content replacement. Read before patch; memory/ is forbidden.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "file path (relative to cwd)"
          },
          "old_content": {
            "type": "string",
            "description": "exact text to replace"
          },
          "new_content": {
            "type": "string",
            "description": "replacement text"
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "file_write",
      "description": "Write/create a file (content, optional append mode). Writing under memory/ is forbidden; use memory_write/memory_patch for the store.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "file path (relative to cwd)"
          },
          "content": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "overwrite",
              "append",
              "prepend"
            ],
            "description": "write mode (append optional)",
            "default": "overwrite"
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "grep",
      "description": "Search file contents before file_read when you don't know where a symbol/string lives. Rust regex syntax; no lookaround/backrefs. Honors .gitignore. Returns path:line:text grouped by file.",
      "parameters": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "description": "Regex, or literal when fixed_strings=true"
          },
          "path": {
            "type": "string",
            "description": "File or directory, relative to workspace",
            "default": "."
          },
          "glob": {
            "type": "string",
            "description": "Only search files matching this glob, e.g. '*.py'"
          },
          "case_sensitive": {
            "type": "boolean",
            "default": false
          },
          "fixed_strings": {
            "type": "boolean",
            "default": false
          },
          "files_only": {
            "type": "boolean",
            "default": false
          },
          "context": {
            "type": "integer",
            "default": 0
          },
          "max_results": {
            "type": "integer",
            "default": 100
          }
        },
        "required": [
          "pattern"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "glob",
      "description": "Find files by name or glob pattern. Use before reading when you don't know the file location.",
      "parameters": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "description": "e.g. '**/*.py' or '*Tool*.ts*'"
          },
          "path": {
            "type": "string",
            "description": "Base directory",
            "default": "."
          },
          "max_results": {
            "type": "integer",
            "default": 200
          }
        },
        "required": [
          "pattern"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "file_apply_patch",
      "description": "Apply a multi-file/multi-hunk patch with context matching. Supports Add/Update/Delete/Move. Preferred when editing more than one location; use file_patch for one exact block.",
      "parameters": {
        "type": "object",
        "properties": {
          "patch": {
            "type": "string",
            "description": "Text from *** Begin Patch to *** End Patch"
          }
        },
        "required": [
          "patch"
        ]
      }
    }
  },
