  {
    "type": "function",
    "function": {
      "name": "sandbox_run",
      "description": "Execute python inside a guardrailed sandbox (process-level audit hook: writes/deletes limited to the sandbox dir, no subprocesses, no network by default, no ctypes, .env/mykey/repo source/user home reads denied). Routing: research computation / data processing / untrusted throwaway code use this tool; local development or direct repo/user-file operations use code_run. Guardrail prevents accidents, not adversarial escape. Dangerous patterns (subprocess/ctypes/network...) require ask_user consent, then retry with confirmed=true.",
      "parameters": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "python code"
          },
          "network": {
            "type": "boolean",
            "description": "allow network (default false, needs user consent)"
          },
          "timeout": {
            "type": "integer",
            "description": "seconds, default 120, max 600"
          },
          "confirmed": {
            "type": "boolean",
            "description": "user confirmed dangerous patterns (default false)"
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
