        <mxCell id="bar_s3" value="7d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#d79b00;fontSize=9.5;fontColor=#8a5a00;labelBackgroundColor=#ffffff;exitX=0.44;exitY=0;exitDx=0;exitDy=0;entryX=0.35;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="bar" target="s3">
