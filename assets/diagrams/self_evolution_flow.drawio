        <mxCell id="s3_label" value="写回新知识" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3d6b2e;" vertex="1" parent="1">
          <mxGeometry x="660" y="692" width="110" height="24" as="geometry" />
