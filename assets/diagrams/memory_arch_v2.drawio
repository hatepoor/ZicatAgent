        <mxCell id="zLayers" value="记忆分层（库字段 layer；L0 为代码资产）" style="swimlane;startSize=30;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;fontStyle=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1460" height="250" as="geometry" />
        </mxCell>
        <mxCell id="zRuntime" value="运行时读写（当前会话）" style="swimlane;startSize=30;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;fontStyle=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="290" width="720" height="520" as="geometry" />
        </mxCell>
        <mxCell id="zFiles" value="文件 ↔ 库 / 运维" style="swimlane;startSize=30;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;fontStyle=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="290" width="720" height="520" as="geometry" />
        </mxCell>
        <mxCell id="zDirs" value="memory/ 目录 ↔ 层（门牌）" style="swimlane;startSize=30;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;fontStyle=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="830" width="1460" height="190" as="geometry" />
        </mxCell>

        <!-- Layers -->
        <mxCell id="L0" value="L0 · 宪法 / META-SOP&#xa;L0-a：assets/sys_prompt + l1_structure&#xa;L0-b：memory/kb/memory_management_sop.md&#xa;写：开发者；模型改不到&#xa;读：每任务 system prompt / start_long_term_update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10.5;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="zLayers">
          <mxGeometry x="20" y="45" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="L1 · 索引（动态渲染）&#xa;render_l1()：RULES + [FACT]/[SKILL] 列表&#xa;不落盘；每任务注入 system prompt&#xa;库不可用 → memory/l1_fallback.txt&#xa;写：memory_patch(&quot;l1_rules&quot;) 改规则块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="zLayers">
          <mxGeometry x="310" y="45" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="L2 · 事实（长期记忆）&#xa;memory_items(layer=L2, kind=fact)&#xa;git 源：memory/facts.txt（sync 入库）&#xa;读：memory_search / memory_read&#xa;不自动注入 prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="zLayers">
          <mxGeometry x="600" y="45" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="L3 · 能力（知识 + 脚本）&#xa;memory_items(layer=L3, kind=sop/script)&#xa;git 源：memory/kb/*.md + memory/scripts/*.py&#xa;读：memory_read；脚本物化到 temp/skills&#xa;L1 只显示 name — summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10.5;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="zLayers">
          <mxGeometry x="890" y="45" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="L4 · 归档（原始会话）&#xa;原文：memory/L4_raw_sessions/&#xa;库内只存档案卡（layer=L4, kind=archive）&#xa;12h 压缩归档；7d 蒸馏任务&#xa;读：memory_search 摘要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="zLayers">
          <mxGeometry x="1180" y="45" width="260" height="170" as="geometry" />
        </mxCell>
        <mxCell id="l4back" value="7d 蒸馏" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#666666;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="L4" target="L3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

