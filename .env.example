# zicatAgent 模型配置模板：复制为 .env 并填写（.env 已被 gitignore，绝不入库）
# 第 1 个模型：三项必需；字段名对应 mykey.py 模型字典键的小写形式。
# 多模型故障转移：复制一组改序号（ZICAT_OAI_2__...），按序号优先。

ZICAT_OAI_1__APIBASE=https://api.deepseek.com/v1
ZICAT_OAI_1__APIKEY=填你的 API Key
ZICAT_OAI_1__MODEL=填服务商提供的模型名

# ── 可选字段（取消注释生效；数值自动转换，非数值留原样）──
# ZICAT_OAI_1__NAME=主力模型
# ZICAT_OAI_1__PROXY=http://127.0.0.1:7890
# ZICAT_OAI_1__READ_TIMEOUT=180
# ZICAT_OAI_1__TIMEOUT=10
# ZICAT_OAI_1__MAX_RETRIES=3
# ZICAT_OAI_1__CONTEXT_WIN=100000
# ZICAT_OAI_1__MAX_TOKENS=32768
# ZICAT_OAI_1__TEMPERATURE=1.0
# ZICAT_OAI_1__STREAM=false
# ZICAT_OAI_1__REASONING_EFFORT=high
# ZICAT_OAI_1__API_MODE=responses

# ── 第 2 个模型（可选，故障转移）──
# ZICAT_OAI_2__APIBASE=https://备份渠道/v1
# ZICAT_OAI_2__APIKEY=sk-xxx
# ZICAT_OAI_2__MODEL=模型名
# ZICAT_OAI_2__NAME=备用模型

# 说明：
# 1. .env 只承载模型组；mixin_config / 聊天平台 token / graph_config 仍放 mykey.py（可选）。
# 2. .env 存在时其模型组覆盖 mykey.py 的 oai_config*；没有 mykey.py 也能纯 .env 运行。
# 3. 修改 .env 后热重载生效，无需重启。
